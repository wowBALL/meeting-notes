# ค่าเริ่มต้นคือ GLM-5.2 บน endpoint ของบริษัท ซึ่ง transcript ไม่ออกไปไหน
LLM_API_KEY=sk-...
LLM_BASE_URL=https://your-llm-endpoint.example/v1

# จำเป็นเฉพาะเมื่อจะเลือกสรุปด้วย Claude เท่านั้น ปล่อยว่างได้
ANTHROPIC_API_KEY=sk-ant-...
HF_TOKEN=hf_...
CLAUDE_MODEL=claude-opus-5
# small (fast, CPU-friendly) or large-v3 (best quality; needs GPU — see docs/gpu-setup.md)
WHISPER_MODEL=small
